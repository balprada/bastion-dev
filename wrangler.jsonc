// wrangler.jsonc — demo2 branch. Deploy target for the bastion-v2 Workers
// project (production branch: demo2). v1's copy on main keeps the name
// bastion-dev — branches are independent.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "bastion-v2",

  "compatibility_date": "2025-07-15",

  "assets": {
    "directory": "./.output/public",
    "not_found_handling": "single-page-application"
  }
}
